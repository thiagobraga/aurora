# Absolute path of the folder that holds all your projects (one subfolder each).
# Mounted at the same path inside the api container.
PROJECTS_DIR=/home/braga/projects

# `id -u`:`id -g` of your host user (files Aurora writes are owned by it).
DOCKER_USER=1000:1000

# Group owning the docker socket: `stat -c %g /var/run/docker.sock`
DOCKER_GID=999

# Host port for the UI (bound to 127.0.0.1 only) -> http://localhost:7700
AURORA_PORT=7700

# Optional: require a bearer token for the API and websocket.
AURORA_TOKEN=

# Optional: raises the GitHub API limit (60 -> 5000 req/h) and reads private repos.
# Fine-grained token, read-only "Contents" + "Metadata".
GITHUB_TOKEN=

# Traefik settings used by Aurora itself and by the project templates.
LOCAL_DOMAIN=local
TRAEFIK_ENTRYPOINT=websecure

# Identity for the initial commit of scaffolded/imported projects.
GIT_USER_NAME=Thiago Braga
GIT_USER_EMAIL=you@example.com
